#32881=PRODUCT_CONTEXT('part definition',#32880,'mechanical');
#32882=PRODUCT('NAS_TOWER_STORAGE_ROWS','NAS_TOWER_STORAGE_ROWS v17',
'NAS tower storage rows (spec01 rev0.4, SB35 rev1.0): M30 = 8x 3.5in b
ays at 36 mm pitch, M40 = 12x 2.5in bays at 24.8 mm pitch stacked abov
e. Row frame: X across bays (row X=0 = M40 cassette left edge), Y inse
rtion (+Y rear, Y=0 = common cage front plane), Z up (Z=0 = M30 floor-
plate bottom). Bay units are linked references (M30_BAY35_UNIT, M40_BA
Y25_UNIT); end walls/frame not modeled.',(#32881));
#32883=PRODUCT('M40_STORAGE_25','M40_STORAGE_25',
'Row of 12 linked 2.5in bay units (M40_BAY25_UNIT) stacked above M30. 
Cassette-local frame as M30. Bay i PCB face at X = M40_END_ALLOC + HDD
25_T_RESERVE + i*M40_PITCH.',(#32881));
